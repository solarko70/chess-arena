{
  "name": "chess-arena",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-stockfish.mjs",
    "predev": "node scripts/copy-stockfish.mjs",
    "prebuild": "node scripts/copy-stockfish.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node scripts/safe-test.mjs",
    "test:safe": "node scripts/safe-test.mjs",
    "test:raw": "vitest run --exclude src/tests/*.slow.test.ts",
    "test:slow": "vitest run src/tests/ai-levels.slow.test.ts src/tests/review.slow.test.ts",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "stockfish": "19.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/ui": "^2.1.2",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
